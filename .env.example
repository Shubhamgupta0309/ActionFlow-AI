# Database Configuration (MySQL 8.x)
# Example for local MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/actionflow_db
# Example for Aiven Cloud MySQL (SSL enabled):
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/actionflow_db

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth2 Credentials for Gmail Integration (Optional Bonus Feature)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
FRONTEND_URL=http://localhost:5173
